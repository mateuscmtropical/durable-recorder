{
  "name": "durable-recorder",
  "version": "0.0.0",
  "description": "Browser audio, video and screen recording that survives a locked phone, a killed tab or a dropped microphone.",
  "license": "MIT",
  "author": "Mateus Silva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuscmtropical/durable-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/mateuscmtropical/durable-recorder/issues"
  },
  "homepage": "https://github.com/mateuscmtropical/durable-recorder#readme",
  "keywords": [
    "mediarecorder",
    "recorder",
    "audio",
    "video",
    "screen-recording",
    "indexeddb",
    "safari",
    "ios",
    "offline"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./container": {
      "import": {
        "types": "./dist/container.d.ts",
        "default": "./dist/container.js"
      },
      "require": {
        "types": "./dist/container.d.cts",
        "default": "./dist/container.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsup",
    "demo": "esbuild demo/main.ts --bundle --format=esm --outdir=demo/dist --servedir=demo",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "mediabunny": "^1.61.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "mediabunny": "^1.61.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
